# Backend Environment Variables
# ⚠️ NEVER put real secrets in this file. This file IS committed to git.
# Copy this file to: backend/.env
# Then fill in your real credentials in backend/.env (which is gitignored).

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ── Supabase Credentials ───────────────────────────────────────────────────
# Get from: https://supabase.com → Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ── Google Gemini AI ───────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Rate Limiting (Optional) ───────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
