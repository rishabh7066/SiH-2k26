# Frontend Environment Variables
# ⚠️  NEVER put real secrets here. This file IS committed to git.
# Copy this file to: frontend/.env.local  (gitignored)
# Then fill in your real values in .env.local

# ── Supabase (Required) ──────────────────────────────────────────────────────
# Get from: https://supabase.com → Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Backend API URL ──────────────────────────────────────────────────────────
# Local dev: http://localhost:5000/api
# Production: https://your-backend.com/api
VITE_API_URL=http://localhost:5000/api

# ── Google Gemini AI (Optional) ──────────────────────────────────────────────
# Free key from: https://aistudio.google.com/app/apikey
# Leave blank to use backend proxy (recommended for production)
VITE_GEMINI_API_KEY=your-gemini-api-key-here
